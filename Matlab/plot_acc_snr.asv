        xlabel( 'SNR', 'FontSize', 10 )
        ylabel( 'Acc(%)', 'FontSize', 10, 'Rotation', 90 )
        legend({'KNN','NB','SVM','ANN'},'Location','southeast')
        subtitle('Gauss 4 params')
        grid on
